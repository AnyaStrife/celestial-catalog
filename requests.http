@baseUrl = http://localhost:3001/api/celestial-objects

### Get all celestial objects
GET {{baseUrl}}

### Get a celestial object by ID
GET {{baseUrl}}/1

### Create a celestial object
POST {{baseUrl}}
Content-Type: application/json

{
  "name": "Jupiter",
  "type": "planet",
  "constellation": null,
  "distanceLightYears": 0.00008,
  "observed": true
}

### Update a celestial object
PUT {{baseUrl}}/1
Content-Type: application/json

{
  "name": "Bételgeuse",
  "type": "star",
  "constellation": "Orion",
  "distanceLightYears": 550,
  "observed": true
}

### Delete a celestial object
DELETE {{baseUrl}}/2

### Expect a 400 error for invalid data
POST {{baseUrl}}
Content-Type: application/json

{ "name": "", "type": "comet", "distanceLightYears": -5 }

### Expect a 404 error for a non-existent object
GET {{baseUrl}}/9999